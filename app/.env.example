# Firebase web config for u-track (project: u-track-prod).
# Copy this file to `.env.local` (which is gitignored) and fill in the real values
# from the Firebase console → Project settings → Your apps → SDK setup and config.
# Do NOT put real values in this file, and do NOT paste keys into the terminal.
#
# Note: the Firebase web apiKey is shipped to the browser and is NOT a secret — it
# only identifies the project. Real protection comes from Firestore security rules
# and Auth. Keep it in .env.local anyway for hygiene. NEVER commit a service-account
# JSON or any Admin SDK key — those are true secrets and don't belong in this app.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=u-track-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=u-track-prod
VITE_FIREBASE_STORAGE_BUCKET=u-track-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to route Auth + Firestore to the local emulators (fake Google login,
# local data) instead of the real project. Run `firebase emulators:start` first.
VITE_USE_EMULATOR=
